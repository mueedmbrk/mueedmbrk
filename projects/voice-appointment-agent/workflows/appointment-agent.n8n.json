{
  "name": "Voice Appointment Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "incoming-call",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-incoming",
      "name": "📞 Incoming Call (Twilio)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-460, 300],
      "webhookId": "incoming-call"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_BASE_URL }}/call/recording",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ recording_url: $json.body.RecordingUrl }) }}",
        "options": { "timeout": 120000, "retry": { "retryOnFail": true, "maxTries": 3 } }
      },
      "id": "agent-call",
      "name": "🧠 Transcribe + Understand + Book",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-240, 300],
      "notes": "Calls the Python agent: Whisper transcription, Claude intent parsing, slot validation and the calendar write all happen behind this one request, so the booking rules live in tested code rather than in workflow nodes."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "id": "booked",
              "leftValue": "={{ $json.booked }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "was-booked",
      "name": "✅ Booked?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-20, 300]
    },
    {
      "parameters": {
        "operation": "create",
        "calendar": { "__rl": true, "value": "={{ $env.GOOGLE_CALENDAR_ID }}", "mode": "id" },
        "start": "={{ $json.slot.start }}",
        "end": "={{ $json.slot.end }}",
        "additionalFields": {
          "summary": "=Appointment — {{ $json.caller_name || 'caller' }}",
          "description": "=Booked by the voice agent.\nReason: {{ $json.intent }}\nTranscript: {{ $json.transcript }}"
        }
      },
      "id": "calendar-mirror",
      "name": "📅 Mirror to Team Calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [220, 180],
      "notes": "Optional second calendar for the wider team. The authoritative write already happened inside the agent."
    },
    {
      "parameters": {
        "resource": "sms",
        "operation": "send",
        "from": "={{ $env.TWILIO_FROM_NUMBER }}",
        "to": "={{ $json.caller_phone }}",
        "message": "=Your appointment is confirmed for {{ $json.slot.start }}. Reply HELP if you need to change it."
      },
      "id": "sms-confirm",
      "name": "📱 SMS Confirmation",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [440, 180]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "id": "escalated",
              "leftValue": "={{ $json.escalated }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "needs-human",
      "name": "🙋 Needs a Human?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [220, 420]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "={{ $env.SLACK_CHANNEL_ID }}", "mode": "id" },
        "text": "=🙋 *Call needs a human*\n*Caller:* {{ $json.caller_name || 'unknown' }} ({{ $json.caller_phone || 'no number' }})\n*Status:* {{ $json.status }}\n*Transcript:* {{ $json.transcript }}",
        "otherOptions": {}
      },
      "id": "slack-alert",
      "name": "💬 Alert Reception",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [440, 500]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.reply }}",
        "options": { "responseCode": 200 }
      },
      "id": "respond",
      "name": "🔊 Speak Reply to Caller",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [700, 300]
    }
  ],
  "connections": {
    "📞 Incoming Call (Twilio)": {
      "main": [[{ "node": "🧠 Transcribe + Understand + Book", "type": "main", "index": 0 }]]
    },
    "🧠 Transcribe + Understand + Book": {
      "main": [[{ "node": "✅ Booked?", "type": "main", "index": 0 }]]
    },
    "✅ Booked?": {
      "main": [
        [{ "node": "📅 Mirror to Team Calendar", "type": "main", "index": 0 }],
        [{ "node": "🙋 Needs a Human?", "type": "main", "index": 0 }]
      ]
    },
    "📅 Mirror to Team Calendar": {
      "main": [[{ "node": "📱 SMS Confirmation", "type": "main", "index": 0 }]]
    },
    "📱 SMS Confirmation": {
      "main": [[{ "node": "🔊 Speak Reply to Caller", "type": "main", "index": 0 }]]
    },
    "🙋 Needs a Human?": {
      "main": [
        [{ "node": "💬 Alert Reception", "type": "main", "index": 0 }],
        [{ "node": "🔊 Speak Reply to Caller", "type": "main", "index": 0 }]
      ]
    },
    "💬 Alert Reception": {
      "main": [[{ "node": "🔊 Speak Reply to Caller", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "voice-ai" }, { "name": "appointments" }]
}
