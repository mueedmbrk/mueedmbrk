# OCR
TESSERACT_CMD=            # leave blank to use the system default
OCR_LANGUAGE=eng
OCR_DPI=300               # 300 is the accuracy/speed sweet spot for scanned pages

# Routing
MIN_TEXT_LAYER_CHARS=120  # below this a PDF page is treated as scanned and sent to OCR
CLASSIFIER_THRESHOLD=0.18 # below this the document type is reported as "unknown"
