# Where run artifacts are written
OUTPUT_DIR=outputs
STATE_DB=outputs/pipeline.db

# Extraction
API_BASE_URL=
API_TOKEN=
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Data quality gates — a run fails if these are breached
MAX_NULL_RATIO=0.20         # per-column null tolerance
MIN_ROWS=1                  # a run producing fewer rows than this is treated as broken

# Reporting
REPORT_EMAIL_TO=
REPORT_WEBHOOK_URL=
