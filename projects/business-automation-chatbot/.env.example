# Claude API
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
MAX_TOKENS=1024

# Business identity used in the system prompt
BUSINESS_NAME=Acme Consulting
BUSINESS_HOURS=Mon-Fri 9am-6pm PKT
SUPPORT_EMAIL=hello@example.com

# Behaviour
FAQ_CONFIDENCE_THRESHOLD=0.35   # cosine similarity above which the FAQ answer is used directly
MAX_HISTORY_TURNS=12            # conversation turns kept before trimming
HANDOFF_WEBHOOK_URL=            # POSTed when a conversation escalates to a human
