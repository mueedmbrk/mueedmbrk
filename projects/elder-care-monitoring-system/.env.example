# Video source: webcam index (0) or a path/RTSP URL
CAMERA_SOURCE=0

# Detection tuning
FALL_ASPECT_RATIO=1.25          # width/height above which a person reads as horizontal
FALL_CONFIRM_FRAMES=18          # consecutive frames before a fall is confirmed
MIN_CONTOUR_AREA=2500           # ignore blobs smaller than this (pets, shadows)
DROP_VELOCITY=0.045             # normalised centroid drop per frame that counts as a fall

# Alerting
ALERT_COOLDOWN_SECONDS=120
ALERT_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CARER_PHONE_NUMBER=
