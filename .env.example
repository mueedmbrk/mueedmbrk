# Claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5

# Whisper
WHISPER_MODEL=base              # tiny | base | small | medium | large

# Business calendar rules
TIMEZONE=Asia/Karachi
OPENING_HOUR=9
CLOSING_HOUR=17
SLOT_MINUTES=30
BUFFER_MINUTES=0                # gap enforced between appointments
MAX_DAYS_AHEAD=30
WORKING_DAYS=0,1,2,3,4          # Monday=0 ... Sunday=6

# Google Calendar
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Twilio (SMS confirmation)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ElevenLabs (spoken replies)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Escalation
ESCALATION_WEBHOOK_URL=
